# Production values (local development needs none of these: see application.yaml defaults).
# Never commit the real values. Secrets (*) live in Secret Manager, the rest are Cloud Run env vars.
# Cloud Run sets PORT itself.

# Neon, direct endpoint (not -pooler), Frankfurt
DATABASE_URL=jdbc:postgresql://<endpoint>.eu-central-1.aws.neon.tech/<database>?sslmode=require
DATABASE_USER=
# * Secret Manager
DATABASE_PASSWORD=
DATABASE_MAX_POOL_SIZE=5

STORAGE_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
STORAGE_REGION=auto
STORAGE_BUCKET=map-arts
# * Secret Manager
STORAGE_ACCESS_KEY=
# * Secret Manager
STORAGE_SECRET_KEY=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_PUBLIC_BASE_URL=https://images.martp.app

GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=martp-api (https://github.com/manoellribeiro/map-arts)

# The defaults in application.yaml are the Martp project: only set these to change them
# FIREBASE_PROJECT_NUMBER=
# FIREBASE_ALLOWED_APP_IDS=

CORS_ALLOWED_ORIGINS=https://martp.app,https://manoellribeiro.github.io

# JSON logs for Cloud Logging / Error Reporting
JAVA_TOOL_OPTIONS=-Dlogback.configurationFile=logback-cloud.xml
